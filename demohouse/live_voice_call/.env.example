# Required runtime credentials
ARK_API_KEY=your_ark_api_key
LLM1_ENDPOINT_ID=your_llm1_endpoint_id
LLM2_ENDPOINT_ID=your_llm2_endpoint_id
LLM3_ENDPOINT_ID=your_llm3_endpoint_id
LLM1_THINKING_TYPE=disabled
LLM2_THINKING_TYPE=disabled
LLM3_THINKING_TYPE=disabled
# Only effective when THINKING_TYPE=enabled
# LLM1_REASONING_EFFORT=minimal
# LLM2_REASONING_EFFORT=minimal
# LLM3_REASONING_EFFORT=minimal
ASR_APP_ID=your_asr_app_id
ASR_ACCESS_TOKEN=your_asr_access_token
ASR_RESOURCE_ID=volc.bigasr.sauc.duration
# Optional: official SAUC endpoint (default is bigmodel_async)
# ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
TTS_APP_ID=your_tts_app_id
TTS_ACCESS_TOKEN=your_tts_access_token
TTS_SPEAKER=your_tts_speaker

# Let's Encrypt contact email
LETSENCRYPT_EMAIL=2377963631@qq.com

# Admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_now
GRAFANA_PUBLIC_URL=https://smartinterview.cn/observability/
LOKI_RETENTION_PERIOD=168h
PROMETHEUS_RETENTION_DAYS=15

# Public domain used in interview links (service appends /check-in?token=...)
INTERVIEW_BASE_DOMAIN=https://smartinterview.cn

# Redis (required)
REDIS_URL=redis://redis:6379/0

# Optional CORS override for admin API (comma-separated)
# ADMIN_CORS_ORIGINS=https://smartinterview.cn
# ADMIN_LOGIN_FAIL_WINDOW_SECONDS=900
# ADMIN_LOGIN_LOCK_START=5
# ADMIN_LOGIN_LOCK_MAX_SECONDS=60
# ADMIN_LOGIN_GUARD_PREFIX=admin:login:guard

# Optional backend tuning
# Optional frontend dev proxy target (use when localhost:8890 is occupied)
# ADMIN_API_PROXY_TARGET=http://127.0.0.1:18990
# ASR_SILENCE_TIMEOUT_MS=8000
# ASR_MANUAL_TURN_END_ENABLED=false
# INTERVIEW_GLOBAL_TURN_LIMIT=300
# LLM_CONCURRENT_REQUESTS=5
# MAX_ACTIVE_INTERVIEWS=5
# INTERVIEW_OCCUPANCY_KEY_PREFIX=interview:occupancy
# INTERVIEW_OCCUPANCY_TTL_SECONDS=30
# INTERVIEW_OCCUPANCY_HEARTBEAT_SECONDS=10
# INTERVIEW_EXPIRY_KEY_PREFIX=interview:expiry
# INTERVIEW_EXPIRY_SWEEP_SECONDS=10
# INTERVIEW_EXPIRY_SWEEP_BATCH_SIZE=200
# WS_PING_INTERVAL_SECONDS=20
# WS_PING_TIMEOUT_SECONDS=20
# WS_CLOSE_TIMEOUT_SECONDS=5
# ASYNC_LOG_QUEUE_SIZE=10000
# ASYNC_LOG_FLUSH_INTERVAL_MS=200
# ASYNC_LOG_DROP_POLICY=drop_oldest
# ASYNC_LOG_CLOSE_TIMEOUT_SECONDS=5
# INTERVIEW_LOGGER_CACHE_MAX=1000
# INTERVIEW_LOGGER_IDLE_SECONDS=900
# FRONTEND_LOG_MAX_BODY_BYTES=262144
# FRONTEND_LOG_MAX_ENTRIES=200
# FRONTEND_LOG_MAX_ENTRY_CHARS=2000
# SCORING_DEBUG_LOG_ENABLED=true
# SCORING_LOG_RAW_PREVIEW_CHARS=800
# MODERN_PUBLIC_MANUAL_END_ANSWER_ENABLED=false
# MODERN_PUBLIC_ENABLE_LIVE_SUBTITLE=false
# INTERVIEW_CACHE_TTL_SECONDS=60
# INTERVIEW_CACHE_NEGATIVE_TTL_SECONDS=15
# INTERVIEW_TTS_MEM_CACHE_MAX_ENTRIES=2000
# INTERVIEW_TTS_MEM_CACHE_TTL_SECONDS=1800
# AUDIO_COMPRESS_ENABLED=true
# CANDIDATE_MP3_BITRATE_KBPS=32
# INTERVIEWER_MP3_BITRATE_KBPS=32
# CANDIDATE_AUDIO_SAMPLE_RATE=16000
# INTERVIEWER_AUDIO_SAMPLE_RATE=24000
# CANDIDATE_AUDIO_CHANNELS=1
# INTERVIEWER_AUDIO_CHANNELS=1
# FFMPEG_BIN=ffmpeg
